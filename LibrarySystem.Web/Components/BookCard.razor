@using LibrarySystem.Core

<div class="card h-100 shadow-sm border-0" style="border-left: 5px solid @(Book.IsAvailable ? "#198754" : "#dc3545") !important;">
    <div class="card-body d-flex flex-column">
        <h5 class="card-title fw-bold text-truncate" title="@Book.Title">@Book.Title</h5>
        <h6 class="card-subtitle mb-3 text-muted">@Book.Author</h6>
        
        <p class="card-text small mb-4">
            <strong>År:</strong> @Book.PublishedYear <br />
            <strong>ISBN:</strong> @Book.ISBN
        </p>
        <div class="mt-auto">
            @if (Book.IsAvailable)
            {
                <span class="badge bg-success rounded-pill px-3 py-2 w-100 d-block">🟢 Tillgänglig</span>
            }
            else
            {
                <span class="badge bg-danger rounded-pill px-3 py-2 w-100 d-block">🔴 Utlånad</span>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Book Book { get; set; } = default!;
}