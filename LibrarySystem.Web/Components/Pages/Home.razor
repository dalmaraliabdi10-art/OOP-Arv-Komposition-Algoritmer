@page "/"
@using LibrarySystem.Core.Interfaces
@inject IBookRepository BookRepo
@rendermode InteractiveServer

<PageTitle>Bibliotek 2.0</PageTitle>

<div class="p-5 mb-4 bg-light rounded-3 shadow">
    <div class="container-fluid py-5">
        <h1 class="display-5 fw-bold">📚 Välkommen till Bibliotekssystemet</h1>
        <p class="col-md-8 fs-4">Ett modernt system byggt med Blazor och Entity Framework Core.</p>
        <a href="/books" class="btn btn-primary btn-lg">Gå till Bokkatalogen</a>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <div class="card text-white bg-primary shadow">
            <div class="card-body text-center">
                <h3>@TotalBooks</h3>
                <p>Registrerade böcker</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-white bg-success shadow">
            <div class="card-body text-center">
                <h3>@AvailableBooks</h3>
                <p>Tillgängliga för lån</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-white bg-warning shadow">
            <div class="card-body text-center">
                <h3>Snabbval</h3>
                <a href="/loans" class="btn btn-dark btn-sm mt-2">Hantera lån</a>
            </div>
        </div>
    </div>
</div>

@code {
    private int TotalBooks = 0;
    private int AvailableBooks = 0;
    protected override async Task OnInitializedAsync()
    {
        var books = await BookRepo.GetAllAsync();
        TotalBooks = books.Count();
        AvailableBooks = books.Count(b => b.IsAvailable);
    }
}