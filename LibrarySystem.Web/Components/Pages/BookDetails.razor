@page "/books/{Id:int}"
@using LibrarySystem.Core
@using LibrarySystem.Core.Interfaces
@inject IBookRepository BookRepo
@inject ILoanRepository LoanRepo
@rendermode InteractiveServer

<PageTitle>Bokdetaljer</PageTitle>

<div class="container mt-4 mb-5">
    @if (book == null)
    { // Visas medan boken laddas eller om den inte hittas
        <p><em>Laddar bok...</em></p>
    }
    else
    { // Detaljvy för en specifik bok
        <div class="mb-3">
            <a href="/books" class="btn btn-outline-secondary btn-sm">← Tillbaka till boklistan</a>
        </div>

        <div class="card shadow-sm border-0 mb-4" style="border-left: 5px solid #0d6efd !important;">
            <div class="card-body p-4">
                <h2 class="fw-bold mb-1">@book.Title</h2>
                <h5 class="text-muted mb-4">Av @book.Author</h5>
                
                <div class="row">
                    <div class="col-md-6">
                        <p class="mb-1"><strong>ISBN:</strong> @book.ISBN</p>
                        <p class="mb-1"><strong>Utgivningsår:</strong> @book.PublishedYear</p>
                    </div>
                    <div class="col-md-6 text-md-end mt-3 mt-md-0">
                        <p class="mb-2"><strong>Status:</strong></p>
                        @if (book.IsAvailable)
                        {
                            <span class="badge bg-success fs-6 px-3 py-2 rounded-pill">🟢 Tillgänglig</span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6 px-3 py-2 rounded-pill">🔴 Utlånad</span>
                        }
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    @if (book.IsAvailable)
                    {
                        <a href="/loans" class="btn btn-primary">Gå till Utlåning för att låna ut</a>
                    }
                    else
                    {
                        <button class="btn btn-warning" @onclick="ReturnBook">Återlämna denna bok nu</button>
                    }
                </div>
            </div>
        </div>

        <h4 class="fw-bold mb-3">Lånehistorik för boken</h4>
        @if (bookLoans == null || !bookLoans.Any())
        {
            <div class="alert alert-info">Boken har ingen tidigare lånehistorik.</div>
        }
        else
        { // Tabell som visar både aktiva och tidigare lån för boken
            <div class="table-responsive shadow-sm">
                <table class="table table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Lånades av</th>
                            <th>Utlånad datum</th>
                            <th>Återlämnad datum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loan in bookLoans)
                        {
                            <tr>
                                <td>@loan.Member?.Name</td>
                                <td>@loan.LoanDate.ToShortDateString()</td>
                                <td class="fw-bold @(loan.ReturnDate == null ? "text-danger" : "text-success")">
                                    @(loan.ReturnDate?.ToShortDateString() ?? "Aktivt lån just nu")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code { // Tar emot Id:t från URL:en
    [Parameter]
    public int Id { get; set; }

    private Book? book;
    private IEnumerable<Loan>? bookLoans;
    private Loan? activeLoan;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    { // Hämtar boken baserat på Id:t
        book = await BookRepo.GetByIdAsync(Id);

        if (book != null)
        {
            var allActive = await LoanRepo.GetAllActiveLoansAsync();
            var allHistory = await LoanRepo.GetLoanHistoryAsync();

            bookLoans = allActive.Where(l => l.BookId == Id)
                        .Concat(allHistory.Where(l => l.BookId == Id))
                        .OrderByDescending(l => l.LoanDate);

            activeLoan = allActive.FirstOrDefault(l => l.BookId == Id);
        }
    }

    private async Task ReturnBook()
    {
        if (activeLoan != null)
        {
            await LoanRepo.ReturnLoanAsync(activeLoan.Id);
            await LoadData(); // Uppdaterar sidan direkt
        }
    }
}